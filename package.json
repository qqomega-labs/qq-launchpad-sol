{
  "name": "qq-launchpad-sol",
  "private": true,
  "version": "0.0.0",
  "description": "Solana launchpad for the QQ Omega token with Meteora Dynamic Bonding Curve",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "QQ Omega Labs <info@qqomega.xyz> (https://github.com/qqomega-labs)",
  "contributors": [
    {
      "name": "qqalpha",
      "url": "https://github.com/qqalpha"
    },
    {
      "name": "qqsigma",
      "url": "https://github.com/qqsigma"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qqomega-labs/qq-launchpad-sol.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@jup-ag/wallet-adapter": "^0.2.6",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.7",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9",
    "@solana/wallet-adapter-react": "^0.15",
    "@solana/web3.js": "^1.98",
    "bn.js": "^5",
    "buffer": "^6",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5",
    "lucide-react": "^1.7.0",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "ws>utf-8-validate": "6",
        "eslint-plugin-react-hooks>eslint": "10"
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.0",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bn.js": "^5",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.2",
    "wrangler": "^4.80.0"
  }
}
